{
  "apiVersion": 1,
  "id": "key-protocol",
  "type": "startup",
  "name": "密钥协议",
  "author": "tdragon6",
  "version": "0.1.1",
  "description": "加密载波捕获、六段密钥解密与安全通道解锁",
  "themes": ["dark", "light"],
  "languages": ["zh", "en"],
  "entry": "source/index.html",
  "preview": "cover.png",
  "parameters": [
    {
      "key": "speed",
      "label": "速度",
      "type": "number",
      "default": 1,
      "min": 0.5,
      "max": 2,
      "step": 0.25
    },
    {
      "key": "identity",
      "label": "身份名称",
      "type": "text",
      "default": "tdragon6",
      "maxLength": 32,
      "pattern": "identity"
    },
    {
      "key": "sound",
      "label": "音乐",
      "type": "boolean",
      "default": true
    },
    {
      "key": "volume",
      "label": "音量",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05
    }
  ],
  "license": "MIT",
  "i18n": {
    "en": {
      "name": "Key Protocol",
      "description": "Intercept an encrypted carrier, recover six key fragments, and unlock a secure channel",
      "parameters": {
        "speed": { "label": "Speed" },
        "identity": { "label": "Identity name" },
        "sound": { "label": "Music" },
        "volume": { "label": "Volume" }
      }
    }
  }
}
