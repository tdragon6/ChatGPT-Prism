{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Prism",
  "identifier": "dev.tdragon6.chatgpt-prism",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["desktop"],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; media-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' about:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["script-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Startup animations for ChatGPT",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
